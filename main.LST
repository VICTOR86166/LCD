 461          void  MCU_Init(void)
 462          {
 463   1          unsigned char n;
 464   1              PCA0MD &= ~0x40;
 465   1      
 466   1              //OSC
 467   1          OSCICN = 0x83;        //Internal oscillator enabled, SYSCLK = Internal Oscillator = 12MHz
 468   1          CLKMUL = 0x00;    //Select internal oscillator as clock multiplier source clock
 469   1      
 470   1          CLKMUL |= 0x80;   //Enable clock multiplier
 471   1      
 472   1              for(n=0;n<255;n++);
 473   1      
 474   1              CLKMUL |= 0xC0;           //Initialize the clock multiplier
 475   1              while(!(CLKMUL & 0x20));  //Wait for multiplier to lock
 476   1          CLKSEL = 0x00;            //Change SYSCLK to (4x Multiplier    ) = 48MHz  (48MHz is as fast as F34 wil
             -l run); 0x03;
 477   1         
 478   1          RSTSRC   |= 0x02;  
 479   1      
 480   1              //P0~P4                                  //set high impedance , skipped by crossbar
 481   1              P0MDIN |= 0xFF;          //数字输入(无模拟输入）
 482   1              P0MDOUT |= 0xFF;                 //推挽输出（可选开漏输出，输出设为推挽，输入设为开漏）
 483   1      
 484   1          P1MDOUT |= 0xFF;         
 485   1          P1MDIN |= 0xFF; 
 486   1      
C51 COMPILER V9.00   MAIN                                                                  03/10/2026 11:21:11 PAGE 9   

 487   1          P2MDOUT |= 0xFF;                            
 488   1              P4MDOUT |= 0xFF;         
 489   1      
 490   1              P3MDIN |= 0xFF;
 491   1              P3MDOUT |= 0x17;                 //0001 0111
 492   1      
 493   1               OE=0;
 494   1           DIR=0;
 495   1      
 496   1              //TP_PENIRQ = 1;
 497   1              //TP_DOUT = 1;
 498   1      
 499   1          XBR0     |= 0x02;
 500   1          XBR1     |= 0x40;       // Enable Crossbar
 501   1      
 502   1      }
